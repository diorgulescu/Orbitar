# ============================================================================
# Orbitar — Configurație Apache / LiteSpeed (cPanel Namebox.ro) pentru orbitar.ro
# ============================================================================

# 1. Redirecționare automată HTTP -> HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2. Tipuri MIME corecte pentru SVG, JSON și WebManifest
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddCharset UTF-8 .html .css .js .json .svg
</IfModule>

# 3. Compresie Brotli (dacă este disponibilă pe LiteSpeed/Apache) și Gzip (DEFLATE)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# 4. Cache-Control inteligent pentru performanță maximă (100/100 PageSpeed)
<IfModule mod_headers.c>
  # Securitate de bază și protecția confidențialității
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HTML: revalidare rapidă pentru actualizări imediate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # CSS, JS, SVG, Iconițe: cache pe termen lung
  <FilesMatch "\.(css|js|svg|ico|webp|png|jpg|jpeg)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

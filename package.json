{
  "name": "orbitar",
  "version": "1.2.11",
  "description": "Orbitar — Planetariu Didactic Interactiv în limba română (6–12 ani)",
  "license": "GPL-3.0-or-later",
  "author": "Dragoş Iorgulescu <32508790+diorgulescu@users.noreply.github.com>",
  "contributors": [
    "Dragoş Iorgulescu <32508790+diorgulescu@users.noreply.github.com>",
    "Google Antigravity (Gemini) <176961590+gemini-code-assist[bot]@users.noreply.github.com>",
    "Mistral Vibe <vibe@mistral.ai>"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "test": "node scripts/run-tests.mjs",
    "lint": "biome lint src tests scripts public vite.config.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "build": "tsc && vite build",
    "build:landing": "rm -rf dist-landing && mkdir -p dist-landing && cp -R landing/. dist-landing/ && cp GHID-INSTALARE-PROFESORI.md dist-landing/",
    "build:all": "npm run build && npm run build:landing",
    "build:release": "node scripts/bump-version.mjs patch && npm run build:all",
    "version:sync": "node scripts/bump-version.mjs sync",
    "version:bump": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "release": "node scripts/bump-version.mjs patch --tag",
    "release:push": "node scripts/bump-version.mjs patch --tag --push",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "fetch:textures": "bash scripts/fetch-textures.sh",
    "fetch:hd-textures": "bash scripts/fetch-hd-textures.sh",
    "fetch:nasa-media": "bash scripts/fetch-nasa-media.sh",
    "generate:tts": "node scripts/generate-tts-ro.mjs",
    "build:book": "bash carte/build.sh"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "satellite.js": "^5.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@tauri-apps/cli": "^2.1.0",
    "@types/three": "^0.170.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
